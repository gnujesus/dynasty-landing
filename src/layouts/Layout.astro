---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Dynasty Workshop | Reparaciones de Precisión & Repuestos Automotrices",
  description = "Taller automotriz de alta precisión y catálogo de repuestos certificados para vehículos japoneses, americanos y europeos en República Dominicana. Cotizaciones vía WhatsApp al +1 (829) 462-7157.",
  image = "/assets/dynasty-logo.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://dynastyworkshop.com");

const structuredData = {
  "@context": "https://schema.org",
  "@type": ["AutoRepair", "AutoPartsStore"],
  "name": "Dynasty Workshop",
  "description": description,
  "image": "https://dynastyworkshop.com/assets/dynasty-logo.png",
  "telephone": "+18294627157",
  "email": "admin@dynasty.do",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Santo Domingo",
    "addressCountry": "DO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "18.4861",
    "longitude": "-69.9312"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  ],
  "priceRange": "$$",
  "servesCuisine": undefined
};
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#0a0a0c]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/dynasty-logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/dynasty-logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="taller mecanico republica dominicana, repuestos bmw, repuestos toyota, repuestos mercedes, desabolladura pintura, dynasty workshop, autopartes santo domingo" />
    <meta name="author" content="Dynasty Workshop" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Dynasty Workshop" />
    <meta property="og:locale" content="es_DO" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org JSON-LD Structured Data for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Inter:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0a0a0c] text-[#f7f7f7] min-h-screen antialiased selection:bg-[#c7a12b] selection:text-black">
    <slot />
  </body>
</html>
